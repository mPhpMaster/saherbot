# BOT_TOKEN from @BotFather (required)
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_TOKEN=

# Primary group (required). NOTIFY_RUN + admin checks from private use this id.
CHAT_ID=

# Optional: comma-separated supergroup ids to moderate. If set, other groups/channels are ignored.
# CHAT_ID must be one of these ids. Example for two groups:
# MONITORED_CHAT_IDS=-1001761236054,-1001845637233
MONITORED_CHAT_IDS=

# Maximum message length allowed (default: 300)
MSG_LENGTH=300

# Send notification when bot starts (1=yes, 0=no)
NOTIFY_RUN=0

# Enable echo command for debugging (1=yes, 0=no)
ECHO_COMMAND=0
