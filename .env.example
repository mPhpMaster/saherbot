# --- Database ---
# DB_TYPE: sqlite | postgresql | mysql
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
# SQLite: path to .db file (relative to project root or absolute). Other drivers: database name.
# When DB_TYPE is sqlite and DB_DATABASE is empty, default is data/saherbot.db.
DB_DATABASE=data/saherbot.db

# Web dashboard (required to open the UI)
DASHBOARD_PASSWORD=
# Session signing (falls back to DASHBOARD_PASSWORD if empty)
DASHBOARD_SECRET=
DASHBOARD_HOST=127.0.0.1
# Default 80 when unset or empty
DASHBOARD_PORT=

# Bot token, primary chat, monitored groups, lengths, notify, echo:
# set all of these in the dashboard (global settings + chats + replies).
